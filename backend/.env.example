# Copy to backend/.env and adjust.
DEBUG=false

# Allowed dashboard origins. This is a list field, so pydantic-settings
# parses it as JSON — a bare comma-separated string fails at startup.
# Omit the line entirely to accept the localhost:5173 defaults.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MVP persistence (SQLite file lives under backend/).
DATABASE_URL=sqlite:///./fsra.db

# RAG vector store location.
VECTOR_STORE_PATH=./data/vector_store

# LLM provider. Leave unset to run in evidence-only mode (no narration).
#
# Groq (hosted, free tier, no local install):
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b        <- check /v1/models; names get retired
# GROQ_API_KEY=your-key-here          <- never commit a real key
#
# Ollama (local, offline):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
